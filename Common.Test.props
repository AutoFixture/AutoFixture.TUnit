<Project>
  <PropertyGroup>
    <SignAssembly>False</SignAssembly>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>

    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>

    <!-- Configure static code analysis -->
    <RunCodeAnalysis>false</RunCodeAnalysis>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-Default</AnalysisLevel>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Disable source link support for test projects as they are not publishable. -->
    <SourceLinkCreate>false</SourceLinkCreate>

    <!-- CS8632: Nullable is off in tests; allow ? annotations that mirror product APIs. -->
    <!-- CA1707: Underscores in test method names (SUT_Scenario_Assertion). -->
    <!-- IDE0058: Assert helpers return values that tests intentionally ignore. -->
    <NoWarn>$(NoWarn);CS8632;CA1707;IDE0058</NoWarn>

    <!--Prevents failing cross target NuGet package restores-->
    <DisableImplicitNuGetFallbackFolder>true</DisableImplicitNuGetFallbackFolder>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.10.0" />

    <!-- Style via .editorconfig; StyleCop stays on the product library only. -->
    <PackageReference Remove="StyleCop.Analyzers" />
  </ItemGroup>
</Project>
